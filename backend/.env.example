DEBUG=false
CORS_ORIGINS=https://energy-brain-frontend.onrender.com,http://localhost:5173,https://energy-brain-backend.onrender.com,https://hackathon-energy-brain-1.onrender.com,*
DATABASE_URL=sqlite:///./energy_brain.db
ENABLE_LIVE_CONNECTORS=true
# 5 Data Resources - live integration keys (optional, fallback to dataset_snapshot -> synthetic_fallback)
# 1. NREL NSRDB - solar irradiance GHI/DNI/DHI
NREL_API_KEY=
# 2. NOAA GFS via Open-Meteo - keyless, genuinely live out-of-the-box, no key needed
#    Endpoint: https://api.open-meteo.com/v1/gfs
# 3. Electricity Maps - carbon intensity & power mix (BD->BD, DE->DE, US->US-MIDA-PJM)
ELECTRICITYMAPS_API_KEY=
# 4. OPSD - bundled real sample CSV at backend/app/data/datasets/opsd_de_sample.csv + live CSV from GitHub
#    No key needed, CC BY 4.0
# 5. PJM Data Miner - US PJM load, LMP, fuel mix (optional key, else snapshot)
PJM_API_KEY=
# Optional LLM keys for copilot
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
